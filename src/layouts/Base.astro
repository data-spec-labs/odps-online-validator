---
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = 'ODPS Family Validator — Validate Open Data Products Standards Online',
  description = 'Free online validator for ODPS Spec 4.x, Bitol ODPS Standard 1.0, ODPC, ODPG, and ODPV. Paste YAML or JSON and get instant in-browser schema validation.',
  canonical = 'https://odps-validator.com/',
} = Astro.props;

const webAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'ODPS Family Validator',
  url: 'https://odps-validator.com',
  description,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web Browser',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  featureList: [
    'Validate ODPS Spec (LF) data product YAML and JSON',
    'Validate Bitol ODPS Standard (kind: DataProduct)',
    'Validate ODPC catalogs, ODPG graphs, and ODPV vocabulary',
    'Support for ODPS Spec 4.1 and 4.0, Bitol ODPS 1.0.0 and 0.9.0',
    'Automatic document kind and version detection',
    'Instant error highlighting with field paths',
    'Multiple example documents to try',
  ],
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is the Open Data Product Specification (ODPS Spec)?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'ODPS Spec is a Linux Foundation open specification (Apache 2.0) for machine-readable data product metadata — covering product details, SLA, data quality, pricing, licensing, access, and business strategy.',
      },
    },
    {
      '@type': 'Question',
      name: 'Are there two different standards both called ODPS?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. ODPS Spec (Open Data Product Specification) from opendataproducts.org uses a product root object and versions 4.x. ODPS Standard (Bitol) uses apiVersion, kind: DataProduct, and ports. This validator supports both and labels them distinctly.',
      },
    },
    {
      '@type': 'Question',
      name: 'Which standards does this validator support?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'ODPS Spec 4.1 and 4.0, Bitol ODPS Standard 1.0.0 and 0.9.0, ODPC 1.0 (catalogs), ODPG 1.0 (graphs), and ODPV 1.0 (vocabulary). The validator auto-detects the document kind from structure and the appropriate version field.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is my document sent to a server?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. All validation runs entirely in your browser. JSON Schemas are bundled with the page. Your document never leaves your machine.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the difference between version and productVersion in ODPS Spec?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'version is the ODPS Spec version (e.g. 4.1). productVersion is the data product\'s own semver, tracking how the product metadata has changed over time. In Bitol ODPS Standard, apiVersion is the standard version.',
      },
    },
  ],
};
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="ODPS Family Validator" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <script type="application/ld+json" set:html={JSON.stringify(webAppJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-N7J8B1HFJM"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-N7J8B1HFJM');
    </script>

  </head>
  <body>
    <slot />
  </body>
</html>
